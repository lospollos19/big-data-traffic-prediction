{
  "name": "traffic-prediction",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",

  // Spark application UI, master UI and worker UI
  "forwardPorts": [4040, 8080, 8081],

  "customizations": {
    "vscode": {
      "extensions": ["scalameta.metals"]
    }
  },

  // Keep sbt and coursier caches between container rebuilds
  "mounts": [
    "source=traffic-sbt-cache,target=/root/.sbt,type=volume",
    "source=traffic-coursier-cache,target=/root/.cache/coursier,type=volume"
  ]
}
